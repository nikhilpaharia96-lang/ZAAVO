# ═══════════════════════════════════════════════════════════
# ZAAVO Frontend — Environment Variables
# Copy to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════

# API Base URL
VITE_API_URL=http://localhost:5000/api

# Socket.io URL
VITE_SOCKET_URL=http://localhost:5000

# Razorpay (public key only — secret stays on backend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Maps API Key (for delivery tracking map)
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key

# Cloudinary (for direct upload widget, optional)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=zaavo_unsigned

# App config
VITE_APP_NAME=ZAAVO
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
